<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>StatMate | Normal Probability & Inverse Normal Calculator</title>
<style>
:root{font-family:system-ui,-apple-system,'Segoe UI',Arial,sans-serif;color:#172b4d;background:#f3f7fc}*{box-sizing:border-box}body{margin:0;padding:22px 12px}.wrap{max-width:1100px;margin:auto}header{margin-bottom:16px}h1{font-size:clamp(1.4rem,3vw,2rem);margin:0 0 7px}p{line-height:1.5}.sub,.hint,.foot{color:#536681}.layout{display:grid;grid-template-columns:minmax(250px,320px) minmax(0,1fr);gap:15px}.panel{background:#fff;border:1px solid #d8e3ef;border-radius:15px;padding:19px;box-shadow:0 4px 18px #193b5d0a}.field{margin:0 0 15px}label{display:block;font-weight:650;font-size:.88rem;margin:0 0 6px}select,input{display:block;width:100%;min-width:0;font:inherit;padding:10px 12px;border:1px solid #b9c9da;border-radius:9px;color:#142d50;background:white}select:focus,input:focus,button:focus-visible{outline:3px solid #a7cef7}.hint{font-size:.79rem;margin-top:5px}.result{background:#edf5ff;border-radius:12px;padding:17px 19px;margin-bottom:13px}.result .expr{font-weight:650;overflow-wrap:anywhere}.result .value{font-weight:760;font-size:2.25rem;color:#1354a3;font-variant-numeric:tabular-nums;margin:5px 0}.result .pct{font-size:.9rem;color:#536681}.notice{font-size:.9rem;color:#955216;line-height:1.5;margin-bottom:9px}.error{color:#a62726;font-size:.92rem;margin-bottom:9px}.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.stat{background:#f6f9fc;border-radius:10px;padding:11px;min-width:0}.stat small{display:block;color:#536681;font-size:.78rem}.stat strong{font-size:1.06rem;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}.legend{display:flex;align-items:center;gap:8px;font-size:.84rem;color:#4d6583}.swatch{width:14px;height:14px;background:#378ce3;border-radius:4px}.buttons{display:flex;gap:7px;flex-wrap:wrap;margin:7px 0 0}button{background:white;color:#183a60;padding:9px 12px;border:1px solid #b4c5d9;border-radius:9px;cursor:pointer;font:inherit}button:hover{background:#eaf3ff}.hide{display:none!important}svg{width:100%;height:auto;display:block}.foot{font-size:.82rem;line-height:1.55;margin-top:14px}#explanation{line-height:1.6;font-size:.93rem}#plot{min-height:200px}.note{background:#f7fafc;border-left:4px solid #2f7bc5;padding:12px 15px;margin:15px 0}.mode{margin-bottom:17px}#params{font-size:.87rem}@media(max-width:720px){.layout{grid-template-columns:1fr}.panel{padding:15px}body{padding:14px 10px}}
</style>
</head>
<body><main class="wrap"><header><h1>📊 StatMate — Normal Curve Calculator</h1><p class="sub">Normal probabilities, sample means, sample proportions, and inverse normal. Watch the shaded area and cutoff change.</p></header>
<div class="layout">
<section class="panel" aria-label="Calculator inputs">
<div class="field mode"><label for="task">Calculation</label><select id="task"><option value="prob">Find a probability (normalcdf)</option><option value="inverse">Find a cutoff (invNorm)</option></select></div>
<div class="field"><label for="rv">Distribution</label><select id="rv"><option value="x">Individual observation (X)</option><option value="mean">Sample mean (X̄)</option><option value="prop">Sample proportion (p̂)</option><option value="z">Standard normal (Z)</option></select></div>
<div class="field" id="murow"><label for="mu">Population mean (μ)</label><input id="mu" type="number" step="any" value="750"></div>
<div class="field" id="sigmarow"><label for="sigma">Population standard deviation (σ)</label><input id="sigma" type="number" step="any" min="0.000001" value="28"></div>
<div class="field hide" id="prow"><label for="p">Population proportion (p)</label><input id="p" type="number" step="any" min="0" max="1" value="0.6"><div class="hint">Enter a decimal between 0 and 1.</div></div>
<div class="field hide" id="nrow"><label for="n">Sample size (n)</label><input id="n" type="number" step="1" min="1" value="49"><div class="hint" id="sehint">Standard error = σ / √n</div></div>
<div class="field" id="prob-region-row"><label for="region">Shade region</label><select id="region"><option value="left">Left tail: below a</option><option value="right">Right tail: above a</option><option value="between">Between a and b</option><option value="outside">Outside a and b</option></select></div>
<div class="field" id="inverse-region-row" style="display:none"><label for="invregion">Inverse probability region</label><select id="invregion"><option value="left">Left-tail area (percentile)</option><option value="right">Right-tail area</option><option value="central">Central area (symmetric)</option></select></div>
<div class="field" id="arow"><label for="a" id="alabel">Cutoff (a)</label><input id="a" type="number" step="any" value="742"></div>
<div class="field hide" id="brow"><label for="b">Upper cutoff (b)</label><input id="b" type="number" step="any" value="758"></div>
<div class="field" id="arearow" style="display:none"><label for="area">Target probability / area</label><input id="area" type="number" step="any" min="0" max="1" value="0.95"><div class="hint">Decimal strictly between 0 and 1. Example: 0.95 = 95%.</div></div>
<div class="buttons"><button id="clt" type="button">CLT example</button><button id="propex" type="button">Proportion example</button><button id="invex" type="button">invNorm example</button><button id="standard" type="button">Standard normal</button></div>
</section>
<section class="panel" aria-label="Normal curve visualization and results">
<div class="result" aria-live="polite"><div class="expr" id="expression">P(X &lt; 742)</div><div class="value" id="answer">0.3875</div><div class="pct" id="percent">38.75% of distribution</div></div>
<div class="error" id="error" role="alert"></div><div class="notice" id="notice" role="status"></div>
<svg id="plot" viewBox="0 0 700 370" role="img" aria-label="Normal distribution curve with probability region shaded"></svg>
<div class="legend"><span class="swatch"></span>Blue shading represents the selected probability region.</div>
<div class="stats" style="margin-top:15px"><div class="stat"><small>Distribution mean</small><strong id="meanout">—</strong></div><div class="stat"><small>Distribution standard error / SD</small><strong id="sdout">—</strong></div><div class="stat"><small>Cutoff z-score 1</small><strong id="zout1">—</strong></div><div class="stat"><small>Cutoff z-score 2</small><strong id="zout2">—</strong></div></div>
<div class="note" id="explanation">Choose your inputs to see the calculation.</div>
</section></div>
<p class="foot"><strong>Model assumptions:</strong> Individual observations use a normal population model. Sample means use a normal model exactly for a normal parent population, and approximately when appropriate CLT conditions hold. Sample proportions use the normal approximation when observations are independent and the success/failure counts are sufficiently large (a common guideline: np ≥ 10 and n(1−p) ≥ 10). Probabilities for proportions must be interpreted with the discrete/binomial nature of counts in mind; this graph shows a continuous normal approximation, without a continuity correction. This is an instructional tool, not a Canvas gradebook or homework-submission service.</p>
</main>
<script>
(()=>{
'use strict';
const $=id=>document.getElementById(id), fields=['task','rv','mu','sigma','p','n','region','invregion','a','b','area'];
// Abramowitz-Stegun erf approximation; Phi accurate to about 1e-7.
function erf(x){let sign=x<0?-1:1; x=Math.abs(x);let t=1/(1+.3275911*x);return sign*(1-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-.284496736)*t+.254829592)*t*Math.exp(-x*x));}
function Phi(z){return 0.5*(1+erf(z/Math.SQRT2));}
// Acklam inverse standard normal approximation, absolute quantile error ~1e-9.
function invPhi(p){if(!(p>0&&p<1))return NaN;const a=[-39.69683028665376,220.9460984245205,-275.9285104469687,138.357751867269,-30.66479806614716,2.506628277459239],b=[-54.47609879822406,161.5858368580409,-155.6989798598866,66.80131188771972,-13.28068155288572],c=[-0.007784894002430293,-0.3223964580411365,-2.400758277161838,-2.549732539343734,4.374664141464968,2.938163982698783],d=[0.007784695709041462,0.3224671290700398,2.445134137142996,3.754408661907416];let q,r;if(p<.02425){q=Math.sqrt(-2*Math.log(p));return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5])/((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);}if(p>.97575){q=Math.sqrt(-2*Math.log(1-p));return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5])/((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);}q=p-.5;r=q*q;return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q/(((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1);}
function fmt(v,d=4){if(!Number.isFinite(v))return '—';return v.toLocaleString('en-US',{maximumFractionDigits:d});}
function getNum(id){let s=$(id).value.trim();return s===''?NaN:Number(s);}
function show(id,visible){$(id).classList.toggle('hide',!visible);}
function updateVisibility(){let rv=$('rv').value,inv=$('task').value==='inverse',r=$('region').value;show('murow',rv==='x'||rv==='mean');show('sigmarow',rv==='x'||rv==='mean');show('prow',rv==='prop');show('nrow',rv==='mean'||rv==='prop');show('prob-region-row',!inv);show('inverse-region-row',inv);show('arow',!inv);show('brow',!inv&&(r==='between'||r==='outside'));show('arearow',inv);$('sehint').textContent=rv==='prop'?'Standard error = √[p(1 − p) / n]':'Standard error = σ / √n';}
function fail(text){$('error').textContent=text;$('notice').textContent='';$('answer').textContent='—';$('expression').textContent='Check inputs';$('percent').textContent='';$('explanation').textContent='';$('plot').replaceChildren();['meanout','sdout','zout1','zout2'].forEach(id=>$(id).textContent='—');}
function draw(){updateVisibility();$('error').textContent='';$('notice').textContent='';let rv=$('rv').value,inv=$('task').value==='inverse',mode=inv?$('invregion').value:$('region').value,mu=getNum('mu'),sigma=getNum('sigma'),p=getNum('p'),n=getNum('n'),a=getNum('a'),b=getNum('b'),area=getNum('area');let m,sd,label,extra='';
if(rv==='z'){m=0;sd=1;label='Z';}else if(rv==='x'){m=mu;sd=sigma;label='X';}else if(rv==='mean'){m=mu;sd=sigma/Math.sqrt(n);label='X̄';if(!Number.isInteger(n)||n<1){fail('Sample size n must be a positive integer.');return;}}else{label='p̂';if(!(p>0&&p<1)){fail('Population proportion p must be strictly between 0 and 1 for this normal approximation.');return;}if(!Number.isInteger(n)||n<1){fail('Sample size n must be a positive integer.');return;}m=p;sd=Math.sqrt(p*(1-p)/n);if(n*p<10||n*(1-p)<10)extra=`Normal approximation warning: np = ${fmt(n*p,2)} and n(1−p) = ${fmt(n*(1-p),2)}; one or both are below 10. Consider an exact binomial calculation instead.`;}
if(!Number.isFinite(m)||!Number.isFinite(sd)||sd<=0){fail('Enter valid parameters and a positive standard deviation.');return;}
let lo,hi,prob,z1,z2,expr,cutoffs=[];
if(inv){if(!(area>0&&area<1)){fail('Target probability must be strictly between 0 and 1.');return;}if(mode==='left'){z1=invPhi(area);a=m+sd*z1;lo=-Infinity;hi=a;prob=area;cutoffs=[a];expr=`Find ${label} cutoff with P(${label} < a) = ${fmt(area,6)}`;}else if(mode==='right'){z1=invPhi(1-area);a=m+sd*z1;lo=a;hi=Infinity;prob=area;cutoffs=[a];expr=`Find ${label} cutoff with P(${label} > a) = ${fmt(area,6)}`;}else{z1=invPhi((1-area)/2);z2=invPhi((1+area)/2);a=m+sd*z1;b=m+sd*z2;lo=a;hi=b;prob=area;cutoffs=[a,b];expr=`Central ${fmt(area*100,3)}% of ${label}: a < ${label} < b`;}}
else{if(!Number.isFinite(a)){fail('Enter a valid cutoff a.');return;}if((mode==='between'||mode==='outside')&&(!Number.isFinite(b)||b<=a)){fail('For two cutoffs, enter b greater than a.');return;}z1=(a-m)/sd;z2=(b-m)/sd;cutoffs=(mode==='between'||mode==='outside')?[a,b]:[a];if(mode==='left'){prob=Phi(z1);lo=-Infinity;hi=a;expr=`P(${label} < ${fmt(a,5)})`;}else if(mode==='right'){prob=Phi(-z1);lo=a;hi=Infinity;expr=`P(${label} > ${fmt(a,5)})`;}else if(mode==='between'){prob=Phi(z2)-Phi(z1);lo=a;hi=b;expr=`P(${fmt(a,5)} < ${label} < ${fmt(b,5)})`;}else{prob=Phi(z1)+Phi(-z2);lo=a;hi=b;expr=`P(${label} < ${fmt(a,5)}) + P(${label} > ${fmt(b,5)})`;}}
prob=Math.max(0,Math.min(1,prob));$('expression').textContent=expr;$('answer').textContent=inv?(cutoffs.length===2?`a = ${fmt(a,6)}   |   b = ${fmt(b,6)}`:fmt(a,6)):prob.toFixed(4);$('percent').textContent=inv?`Area = ${(prob*100).toFixed(2)}%`:`${(prob*100).toFixed(2)}% of the distribution`;$('notice').textContent=extra;$('meanout').textContent=fmt(m,6);$('sdout').textContent=fmt(sd,6);$('zout1').textContent=fmt((a-m)/sd,5);$('zout2').textContent=cutoffs.length===2?fmt((b-m)/sd,5):'—';
let desc=rv==='prop'?`For a sample proportion, the normal approximation has mean p = ${fmt(m,5)} and standard error √[p(1−p)/n] = ${fmt(sd,6)}.`:rv==='mean'?`For a sample mean, the normal model has mean μ = ${fmt(m,5)} and standard error σ/√n = ${fmt(sd,6)}.`:`The normal model has mean ${fmt(m,5)} and standard deviation ${fmt(sd,6)}.`;
if(inv) desc+=cutoffs.length===2?` The central ${(area*100).toFixed(2)}% lies between ${fmt(a,6)} and ${fmt(b,6)} (symmetric cutoffs).`:` The requested ${(area*100).toFixed(2)}% ${mode}-tail area gives cutoff ${fmt(a,6)}.`;else desc+=` The shaded region has approximate probability ${prob.toFixed(4)}.`;
$('explanation').textContent=desc;
const svg=$('plot'),L=40,R=675,B=291,H=220,yBase=B, min=Math.min(m-4*sd,...cutoffs.map(v=>v-.25*sd)),max=Math.max(m+4*sd,...cutoffs.map(v=>v+.25*sd));const xx=v=>L+(v-min)/(max-min)*(R-L),yy=v=>yBase-H*Math.exp(-.5*((v-m)/sd)**2);let xvalues=Array.from({length:500},(_,i)=>min+(max-min)*i/499);const shaded= mode==='left'?[[min,a]]:mode==='right'?[[a,max]]:mode==='between'||mode==='central'?[[a,b]]:[[min,a],[b,max]];
let parts=[`<line x1="${L}" y1="${B}" x2="${R}" y2="${B}" stroke="#6c7e93" stroke-width="1.5"/>`];for(let [s,e] of shaded){s=Math.max(min,s);e=Math.min(max,e);if(s>=e)continue;const vs=[s,...xvalues.filter(x=>x>s&&x<e),e];parts.push(`<path d="M ${xx(s)} ${B} `+vs.map(x=>`L ${xx(x).toFixed(2)} ${yy(x).toFixed(2)}`).join(' ')+` L ${xx(e)} ${B} Z" fill="#4097eb" fill-opacity="0.65"/>`);}
parts.push(`<path d="M ${xvalues.map(x=>xx(x).toFixed(2)+' '+yy(x).toFixed(2)).join(' L ')}" fill="none" stroke="#193c66" stroke-width="3.5"/>`);
for(let k=-3;k<=3;k++){let v=m+k*sd,x=xx(v);if(x<L||x>R)continue;parts.push(`<line x1="${x}" y1="${B}" x2="${x}" y2="${B+6}" stroke="#60758c"/><text x="${x}" y="${B+24}" text-anchor="middle" font-size="12" fill="#51667d">${fmt(v,rv==='prop'?3:2)}</text>`);}
cutoffs.forEach((v,i)=>{let x=xx(v);if(x<L||x>R)return;let labelText=(cutoffs.length===2?(i===0?'a':'b'):'a')+' = '+fmt(v,rv==='prop'?4:2);parts.push(`<line x1="${x}" y1="${B}" x2="${x}" y2="${yy(v)}" stroke="#a95122" stroke-width="2.3" stroke-dasharray="5 4"/><text x="${Math.max(L+38,Math.min(R-38,x))}" y="${Math.max(22,yy(v)-12)}" text-anchor="middle" font-size="14" font-weight="650" fill="#9a421d">${labelText}</text>`);});parts.push(`<text x="350" y="355" text-anchor="middle" fill="#52677d" font-size="14">${rv==='prop'?'Sample proportion (p̂)':rv==='mean'?'Sample mean (X̄)':rv==='z'?'Standard normal Z':'Individual observation X'}</text>`);svg.innerHTML=parts.join('');svg.setAttribute('aria-label',`${expr}. Shaded area ${(prob*100).toFixed(3)} percent.`);
}
fields.forEach(id=>$(id).addEventListener('input',draw));
$('clt').addEventListener('click',()=>{$('task').value='prob';$('rv').value='mean';$('mu').value=750;$('sigma').value=28;$('n').value=49;$('region').value='left';$('a').value=742;draw();});
$('propex').addEventListener('click',()=>{$('task').value='prob';$('rv').value='prop';$('p').value=.6;$('n').value=100;$('region').value='right';$('a').value=.65;draw();});
$('invex').addEventListener('click',()=>{$('task').value='inverse';$('rv').value='z';$('invregion').value='left';$('area').value=.975;draw();});
$('standard').addEventListener('click',()=>{$('task').value='prob';$('rv').value='z';$('region').value='right';$('a').value=1.96;draw();});
draw();
})();
</script></body></html>
